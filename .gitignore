**/fish/fish_variables
**/fish/completions

**/nvim/queries/sand
*.local.*

# Ignore Claude Code files except skills and settings for security reasons
# (prevents committing session data, logs, and potentially sensitive information)
claude/.claude/*
!claude/.claude/skills
!claude/.claude/settings.json

# Same idea for pi: keep configs/extensions/themes, drop secrets and session logs
pi/.pi/agent/auth.json
pi/.pi/agent/sessions/

# Same idea for opencode: keep config/themes, drop secrets and runtime junk
# (opencode regenerates node_modules + package files and a migration backup on launch)
opencode/.config/opencode/auth.json
opencode/.config/opencode/node_modules/
opencode/.config/opencode/package.json
opencode/.config/opencode/package-lock.json
opencode/.config/opencode/bun.lock
opencode/.config/opencode/.gitignore
opencode/.config/opencode/*.tui-migration.bak

